# Bind only to localhost. Never expose without TLS + authenticated reverse proxy.
APP_TOKEN=replace-with-a-long-random-secret
JOBPILOT_DATA=./data
LLM_ENABLED=false
# Any explicitly configured OpenAI-compatible HTTPS endpoint; no paid calls by default.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set verified provider prices in USD per million tokens before enabling.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
AI_DAILY_USD=0.20
AI_DAILY_REQUESTS=10
AI_MAX_OUTPUT_TOKENS=700
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
